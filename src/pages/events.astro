---
/**
 * /events — the 2027 season overview: hero, how it works, the three-card
 * season, the waitlist form, a five-question FAQ, and a closing that sends
 * people to the course. Every event surface renders from /config/events.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { season, eyebrowFor } from '../config/events';
import { offers } from '../config/offers';

const course = offers.course;

const steps = [
  { n: '01', h: 'Join the list.', d: 'Tell us your kids’ ages and which days you’d come to. Two minutes.' },
  { n: '02', h: 'The list picks the weekend.', d: 'We send the options, you vote, we book the room.' },
  { n: '03', h: 'Founding families go first.', d: 'You get the date before anyone else, and the best price we’ll ever offer on it.' },
];

const faqs = [
  { q: 'When exactly?', a: 'We don’t know yet, and we won’t pretend to. The list picks the weekend, and founding families get the date first.' },
  { q: 'How much?', a: 'Not set. Founding families on the list get the best price we ever offer on that event. Nothing is charged until there’s a date and a room.' },
  { q: 'Do I need the course first?', a: 'No. But it’s the best thing you can do while you wait, and everything at the events builds on it. <a href="/#pricing">Start Phone License →</a>' },
  { q: 'Can our church come as a group?', a: 'Yes. Tick “I lead a church or ministry group” on the form and we’ll reach out about group seats. <a href="/churches">For churches →</a>' },
  { q: 'Will the summits be recorded?', a: 'Yes, for everyone registered. The workshop won’t be. That’s the point of the room.' },
];
---

<Base
  title="Live Events — The 2027 Season · Phone License"
  description="Two online summits and one in-person workshop, every year. Nothing to buy yet. Join the list and you’ll hear first, at a founding-family price."
  viewContent="Events Hub"
  ogImage="/og-events.png"
>
  <Nav cta={{ label: 'Get first access', href: '#waitlist' }} />

  <main>
    {/* ── Hero ── */}
    <section class="section hero">
      <div class="wrap">
        <p class="eyebrow">Live events · The 2027 season</p>
        <h1>A few days a year, <span class="accent">we get in a room.</span></h1>
        <p class="lede">
          The course is six weeks at your kitchen table. These are the days we do it together: two online
          summits and one in-person workshop, every year. Nothing to buy yet. Join the list and you’ll hear
          first, at a founding-family price.
        </p>
        <div class="ctas">
          <a href="#waitlist" class="btn btn-primary">Get first access</a>
          <a href="/#pricing" class="btn btn-ghost">Start the course while you wait →</a>
        </div>
      </div>
    </section>

    {/* ── How it works ── */}
    <section class="section band-2">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">How it works</p>
          <h2>No date yet. <span class="accent">That’s on purpose.</span></h2>
        </div>
        <ol class="steps">
          {steps.map((s) => (
            <li class="card step">
              <span class="mono">{s.n}</span>
              <h3>{s.h}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ── The season ── */}
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">The season</p>
          <h2>Three days. <span class="accent">One a season.</span></h2>
        </div>
        <div class="season">
          {season.map((e) => (
            <article class="card ev">
              <p class="mono">{eyebrowFor(e)}</p>
              <h3>{e.name}</h3>
              <p class="blurb">{e.cardBlurb}</p>
              <p class="leave-lbl mono">You’ll leave with</p>
              <ul class="leave">
                {e.cardLeaveWith.map((x) => <li>{x}</li>)}
              </ul>
              <a href={`/${e.slug}`} class="btn btn-dark">Get first access →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ── Waitlist ── */}
    <section class="section band-2" id="first-access">
      <div class="wrap">
        <WaitlistForm />
      </div>
    </section>

    {/* ── FAQ ── */}
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Questions</p>
          <h2>What people ask before they join.</h2>
        </div>
        <Faq items={faqs} name="events-faq" />
      </div>
    </section>

    {/* ── Closing ── */}
    <section class="section closing band-ink">
      <div class="wrap center">
        <h2>While you wait for a room, <span class="accent on-dark">there’s a kitchen table.</span></h2>
        <p class="c-sub">Six weeks, one agreement, a rite of passage your kid will remember. The events build on it.</p>
        <div class="ctas center">
          <a
            href={course.url}
            class="btn btn-white"
            data-kajabi
            data-offer-value={course.pixelValue}
            data-offer-name="Phone License course"
          >
            Start Phone License — ${course.price}
          </a>
          <a href="#waitlist" class="btn btn-ghost">Get first access</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .hero {
    text-align: center;
    padding-block: 64px 48px;
  }
  .hero h1 {
    margin-top: 14px;
  }
  .hero .lede {
    max-width: 660px;
    margin: 18px auto 0;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 28px;
  }
  .center {
    text-align: center;
  }
  .section-head {
    text-align: center;
    max-width: var(--head-maxw);
    margin: 0 auto 32px;
  }
  .section-head .eyebrow {
    margin-bottom: 12px;
  }
  .steps {
    list-style: none;
    display: grid;
    gap: 16px;
  }
  .step {
    padding: 24px;
  }
  .step h3 {
    margin: 10px 0 8px;
  }
  .step p {
    color: var(--ink-2);
  }
  .season {
    display: grid;
    gap: 18px;
  }
  .ev {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
  }
  .ev h3 {
    text-wrap: pretty;
  }
  .blurb {
    color: var(--ink-2);
  }
  .leave-lbl {
    margin-top: 4px;
  }
  .leave {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 8px;
  }
  .leave li {
    position: relative;
    padding-left: 22px;
    color: var(--ink);
    font-size: 15px;
  }
  .leave li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--blue-deep);
  }
  .ev .btn {
    margin-top: auto;
    align-self: flex-start;
  }
  .closing .c-sub {
    color: rgba(255, 255, 255, 0.75);
    max-width: 52ch;
    margin: 14px auto 0;
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 900px) {
    .season {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
