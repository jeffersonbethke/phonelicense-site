---
/**
 * /churches — church & ministry licensing.
 *
 * The commercial model lives in src/config/church.ts, not here. Two paths,
 * priced by WHO pays:
 *   License  $495/yr  → self-serve at /churches/setup, families pay $49.
 *   Prepaid  $25/family → talk to us, families free.
 *
 * Positioning unchanged: works for first-phone AND reset families — most
 * groups are a mix.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import EventSlot from '../components/EventSlot.astro';
import { church, familyIncludes, licenseIncludes, kickoff, familySavings } from '../config/church';
import { churchTestimonials, initials } from '../config/testimonials';
import { site } from '../config/site';

const steps = [
  {
    n: '01',
    h: 'License your church',
    d: `One price for your whole church — $${church.licensePrice} a year, no seats to count.`,
  },
  {
    n: '02',
    h: 'Get your link instantly',
    d: 'The second you check out, your church’s own link, QR code, and share kit appear on screen. Nothing to wait for.',
  },
  {
    n: '03',
    h: 'Host your kickoff night',
    d: 'Play the talk, run the table questions, put your QR on the screen. Families leave with it already in hand.',
  },
];

const faqs = [
  {
    q: 'What does the church actually pay?',
    a: `$${church.licensePrice} a year. That's it — no per-family fee, no seat count, no cap on how many families join. Your families then pay $${church.familyPrice} themselves (instead of $${church.retailPrice}) through your link.`,
  },
  {
    q: 'Can we cover the cost for our families instead?',
    a: `Some churches want to — and for a big push or a whole-congregation rollout, let's talk it through together and set up something that fits. Reach out via “planning something bigger” below. Out of the box, the model is simpler on purpose: you license, your families join at half off.`,
  },
  {
    q: 'How do families actually join?',
    a: 'They tap your church’s link (or scan your QR code) and check out at the church price. No code to remember, nothing to type, nothing for you to hand out or keep track of. We know they came from you automatically.',
  },
  {
    q: 'Is there really nothing to administer?',
    a: 'Nothing. You get one link the moment you check out. There are no seats to allocate, no codes to distribute, no roster to maintain, and no report you have to file. If you can send a text message, you can run this.',
  },
  {
    q: 'Does this work if kids already have phones?',
    a: 'Yes — <b>most groups are a mix.</b> It works for first-phone families and for reset families alike. Nothing gets confiscated; the phone gets re-issued under a new agreement they earn.',
  },
  {
    q: 'What if we want printed materials?',
    a: 'A bulk <b>printed-kit add-on</b> is available on either option — agreements, certificates, and leader guides. Mention it when you reach out and we’ll set it up.',
  },
  {
    q: 'What if we need something bigger?',
    a: 'Planning a denomination-wide or multi-site rollout? Let’s scope it together — see “planning something bigger” below.',
  },
];
---

<Base
  title="For Churches & Ministries — Phone License"
  description={`License Phone License for your whole ministry — $${church.licensePrice} a year, unlimited families, and a kickoff night package to launch it.`}
  viewContent="Churches"
>
  <Nav cta={{ label: 'Get your church link', href: '/churches/setup' }} />

  <main>
    {/* ── Hero ── */}
    <section class="section hero">
      <div class="wrap">
        <p class="eyebrow">For churches &amp; ministries</p>
        <h1>Give every family a <span class="accent">plan for the phone.</span></h1>
        <p class="lede">
          License Phone License for your whole ministry — first-phone families and
          families starting over alike. Most groups are a mix, and it works for both.
        </p>
        <div class="cta-row">
          <a href="/churches/setup" class="btn btn-primary">Get your church link →</a>
          <a href="#kickoff" class="btn btn-ghost">See the kickoff night</a>
        </div>
        <p class="hero-fine">
          ${church.licensePrice}/year · unlimited families · your link is live the moment you check out
        </p>
      </div>
      <figure class="hero-photo">
        <img
          src="/assets/room-wide.jpg"
          alt="A church hall full of parents talking in table groups"
          decoding="async"
        />
        <figcaption class="mono">A parent night, mid–table time.</figcaption>
      </figure>
    </section>

    {/* ── How it works ── */}
    <section class="section band-2">
      <div class="wrap">
        <SectionHead eyebrow="How it works">Three steps. Then your families are in.</SectionHead>
        <div class="steps">
          {steps.map((s) => (
            <div class="card step">
              <span class="mono n">{s.n}</span>
              <h4>{s.h}</h4>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Kickoff Night ── */}
    <section class="section" id="kickoff">
      <div class="wrap">
        <SectionHead eyebrow="Included with every license">
          Don’t just buy a course. <span class="accent">Host a night.</span>
          <Fragment slot="lede">
            Every license comes with a complete kickoff event — a filmed
            {' '}{kickoff.runtime} talk, a run sheet, table questions, and a promo kit.
            You supply the room and the coffee. Families walk out with Phone
            License already in hand.
          </Fragment>
        </SectionHead>

        <div class="kickoff-grid">
          {/* Video preview frame. TODO(inputs): swap for the real embed +
              poster frame once the talk is filmed. Labelled a preview on
              purpose so nobody thinks it's downloadable today. */}
          <figure class="video-frame">
            <div class="video-inner">
              <span class="play" aria-hidden="true">▶</span>
              <p class="video-label">The kickoff talk</p>
              <p class="video-sub">{kickoff.runtime} · filmed in studio</p>
            </div>
            <figcaption class="status">
              <span class="dot" aria-hidden="true"></span>
              {kickoff.status}
            </figcaption>
          </figure>

          <ul class="kickoff-list">
            {kickoff.includes.map((k) => (
              <li>
                <h4>{k.title}</h4>
                <p>{k.detail}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="kickoff-photos">
          <img
            src="/assets/tables-laughing.jpg"
            alt="Parents laughing together at round tables during a kickoff night"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/assets/group-circle.jpg"
            alt="A table group of parents and teens mid-conversation"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="mono photos-cap">Table time — the part of the night families remember.</p>
      </div>
    </section>

    {/* ── Tiers ── */}
    <section class="section band-2" id="tiers">
      <div class="wrap">
        <SectionHead eyebrow="Pricing · simple on purpose">
          One price for your church.{' '}
          <span class="accent">Half off for every family.</span>
        </SectionHead>

        <div class="card license-card">
          <div class="license-main">
            <p class="mono who">Your church · the license</p>
            <p class="price">
              ${church.licensePrice}<span>per year — that's everything the church pays</span>
            </p>
            <p class="blurb">
              Your own link, QR code, share kit, and kickoff night — live the
              moment you check out.
            </p>
            <a href="/churches/setup" class="btn btn-primary">Get your church link →</a>
          </div>
          <ul class="incl">{licenseIncludes.map((f) => <li>{f}</li>)}</ul>
        </div>

        <div class="card license-card fam-card">
          <div class="license-main">
            <p class="mono who">Your families · through your link</p>
            <p class="price">
              ${church.familyPrice}<span>per family — instead of the ${church.retailPrice} everyone else pays</span>
            </p>
            <p class="blurb">
              Families tap your link or scan your QR and check themselves out.
              Nothing for you to collect, count, or run.
            </p>
          </div>
          <ul class="incl">{familyIncludes.map((f) => <li>{f}</li>)}</ul>
        </div>

        <p class="addon">
          Want physical materials? A <b>bulk printed-kit add-on</b> (agreements,
          certificates, leader guides) is available — just ask. Planning a
          big push or a multi-site rollout? See “planning something bigger”
          below.
        </p>
      </div>
    </section>

    {/* ── Church testimonials ──
        Renders ONLY when src/config/testimonials.ts → churchTestimonials has
        entries. Empty today, so the live page shows nothing at all rather than
        placeholder copy. Add a quote there and this section appears by itself. */}
    {churchTestimonials.length > 0 && (
      <section class="section">
        <div class="wrap">
          <SectionHead eyebrow="From church leaders">
            Churches already running it.
          </SectionHead>
          <div class="quotes">
            {churchTestimonials.map((t) => (
              <figure class="card quote">
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  {t.image ? (
                    <img src={t.image} alt="" class="avatar" width="40" height="40" loading="lazy" />
                  ) : (
                    <span class="avatar initials" aria-hidden="true">{initials(t.name)}</span>
                  )}
                  <span class="who">
                    <b>{t.name}</b>
                    <span class="detail">{t.detail}</span>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ── Curriculum preview ── */}
    <section class="section">
      <div class="wrap">
        <SectionHead eyebrow="What families get">The same course — for your whole ministry.</SectionHead>
        <div class="curric">
          {[
            ['Six video modules', 'Driver’s Ed for the device, watched parent + kid together.'],
            ['Hands-on Road Tests', 'They configure the real device; parents verify.'],
            ['The Family Agreement', 'A 9-section agreement each family signs.'],
            ['The License + Ceremony', 'A real certificate and a handoff moment kids remember.'],
          ].map(([h, d]) => (
            <div class="card cpreview">
              <h4>{h}</h4>
              <p>{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── FAQ ── */}
    <section class="section band-2">
      <div class="wrap">
        <SectionHead eyebrow="Questions">What ministry leaders ask.</SectionHead>
        <Faq items={faqs} name="church-faq" />
      </div>
    </section>

    {/* ── Free Leader Preview ── */}
    <section class="section band-ink" id="preview">
      <div class="wrap preview-grid">
        <div>
          <p class="eyebrow on">Free leader preview</p>
          <h2>See it before you bring it to your families.</h2>
          <p class="lede on">
            Get free preview access to the full course and the leader materials.
            No cost, no commitment — we’ll email your access over.
          </p>
        </div>
        <LeadForm
          tags={['Church - Lead']}
          button="Get my free preview"
          variant="primary"
          pixelName="Church Lead"
          confirmTitle="You’re in, {name}."
          confirmBody="Your preview access is on its way by email. Check your inbox."
          nextLabel="Ready now? Get your church link →"
          nextHref="/churches/setup"
        >
          <div slot="extra-fields" class="extra">
            <input type="text" name="church_name" placeholder="Church / ministry name" autocomplete="organization" required />
            <select name="church_size" required aria-label="Approximate size">
              <option value="" disabled selected>Approximate size…</option>
              <option>Under 100</option>
              <option>100–500</option>
              <option>500–1,500</option>
              <option>1,500+</option>
            </select>
            <input type="text" name="role" placeholder="Your role (e.g. Family Pastor)" required />
          </div>
          <span slot="fine">We’ll only use this to set up your preview. No spam.</span>
        </LeadForm>
      </div>
    </section>

    {/* ── Planning something bigger ── */}
    <section class="section">
      <div class="wrap bigger">
        <div>
          <p class="mono">Planning something bigger?</p>
          <h3>Denomination, network, or multi-site?</h3>
          <p>Let’s build a rollout that fits. We’ll help you scope timing, cost, and support.</p>
        </div>
        <a href={site.contactUrl} class="btn btn-dark">Let’s talk →</a>
      </div>

      <div class="wrap ev-slot">
        <p class="mono ev-label">The course is day one · this is every year after</p>
        <EventSlot />
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* This page runs airier than the global 60px rhythm — it reads like a
     brochure, and the photos need room to breathe. */
  .section {
    padding-block: clamp(76px, 9vw, 116px);
  }

  .hero {
    text-align: center;
    padding-block: 88px 84px;
  }
  .hero-photo {
    max-width: 1140px;
    margin: 60px auto 0;
    padding-inline: 20px;
  }
  .hero-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
  }
  .hero-photo figcaption {
    margin-top: 16px;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .hero-photo img {
      aspect-ratio: 4 / 3;
    }
  }
  .hero .lede {
    max-width: 620px;
    margin: 16px auto 0;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 26px;
  }
  .hero-fine {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .steps,
  .tiers,
  .curric {
    display: grid;
    gap: 20px;
    margin-top: 36px;
  }
  .step {
    padding: 24px;
  }
  .step .n {
    color: var(--blue-deep);
  }
  .step h4 {
    margin: 8px 0;
  }
  .step p,
  .cpreview p {
    color: var(--ink-2);
  }

  /* ── Kickoff ── */
  .kickoff-grid {
    display: grid;
    gap: 32px;
    margin-top: 40px;
    align-items: start;
  }
  .video-frame {
    margin: 0;
  }
  .video-inner {
    aspect-ratio: 16 / 9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: linear-gradient(160deg, var(--ink) 0%, #1d2432 100%);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md);
    color: #fff;
    text-align: center;
    padding: 20px;
  }
  .play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    font-size: 17px;
    padding-left: 4px;
    margin-bottom: 8px;
  }
  .video-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
  }
  .video-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--amber-ink);
    background: var(--amber-bg);
    border-radius: var(--r-pill);
    padding: 7px 14px;
    width: fit-content;
    margin-inline: auto;
  }
  .status .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .kickoff-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .kickoff-list li {
    padding-left: 22px;
    border-left: 2px solid var(--blue-tint-2);
  }
  .kickoff-list h4 {
    margin-bottom: 5px;
  }
  .kickoff-list p {
    color: var(--ink-2);
    font-size: 15px;
  }
  .kickoff-photos {
    display: grid;
    gap: 20px;
    margin-top: 56px;
  }
  @media (min-width: 720px) {
    .kickoff-photos {
      grid-template-columns: 3fr 2fr;
    }
  }
  .kickoff-photos img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md);
  }
  .photos-cap {
    margin-top: 18px;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
  }

  /* ── Tiers ── */
  .license-card {
    display: grid;
    gap: 28px;
    padding: 32px;
    margin-top: 36px;
    border-color: var(--blue);
    box-shadow: var(--shadow-md);
  }
  @media (min-width: 760px) {
    .license-card {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
  .license-card .who {
    color: var(--blue-deep);
  }
  .license-card .incl {
    margin-bottom: 0;
  }
  .license-card :global(.btn) {
    width: auto;
  }
  .fam-card {
    margin-top: 20px;
    border-color: var(--line);
    box-shadow: var(--shadow-sm);
  }
  .tier {
    padding: 28px;
    position: relative;
  }
  .tier.featured {
    border-color: var(--blue);
    box-shadow: var(--shadow-md);
  }
  .ribbon {
    position: absolute;
    top: -11px;
    left: 28px;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--r-pill);
  }
  .tier .who {
    color: var(--blue-deep);
  }
  .price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 38px;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 6px 0 12px;
    line-height: 1;
  }
  .price span {
    display: block;
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
    margin-top: 6px;
  }
  .blurb {
    color: var(--muted);
    font-size: 14.5px;
    margin-bottom: 16px;
  }
  .incl {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
  }
  .incl li {
    padding-left: 24px;
    position: relative;
  }
  .incl li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--blue-deep);
  }
  .tier :global(.btn) {
    width: 100%;
  }
  .addon {
    text-align: center;
    max-width: 620px;
    margin: 28px auto 0;
    color: var(--muted);
    font-size: 14.5px;
  }

  /* ── Church quotes ── */
  .quotes {
    display: grid;
    gap: 20px;
    margin-top: 36px;
  }
  .quote {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .quote blockquote {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
    flex: 1;
  }
  .quote blockquote::before {
    content: '“';
    color: var(--blue-tint-2);
    font-size: 34px;
    line-height: 0;
    vertical-align: -10px;
    margin-right: 2px;
  }
  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
    object-fit: cover;
  }
  .avatar.initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--blue-tint);
    color: var(--blue-deep);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .who {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .who .detail {
    font-size: 13px;
    color: var(--muted);
  }

  .cpreview {
    padding: 22px;
  }
  .cpreview h4 {
    margin-bottom: 6px;
  }

  .preview-grid {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  .eyebrow.on {
    color: var(--blue-on-dark);
  }
  .lede.on {
    color: rgba(255, 255, 255, 0.75);
    margin-top: 12px;
  }
  .extra {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .extra input,
  .extra select {
    width: 100%;
    padding: 14px 16px;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
  }

  .bigger {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    padding: 28px;
    background: var(--bg-2);
    border-radius: var(--r-lg);
  }
  .bigger h3 {
    margin: 6px 0;
  }
  .bigger p {
    color: var(--muted);
  }
  .ev-slot {
    margin-top: 32px;
    max-width: 520px;
  }
  .ev-label {
    margin-bottom: 12px;
  }

  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
    .tiers {
      grid-template-columns: repeat(2, 1fr);
      max-width: 780px;
      margin-inline: auto;
    }
    .curric {
      grid-template-columns: repeat(2, 1fr);
    }
    .quotes {
      grid-template-columns: repeat(3, 1fr);
    }
    .kickoff-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 44px;
    }
    .preview-grid {
      grid-template-columns: 1fr 420px;
    }
  }
</style>
