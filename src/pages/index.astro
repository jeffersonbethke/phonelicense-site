---
/**
 * Sales homepage — the ORIGINAL page, verbatim (its own HTML + 58KB stylesheet
 * extracted from the original build), with the requested additions injected
 * using the original's own CSS classes so spacing/design match exactly.
 *
 * Additions: funnel nav (done in body.html), BE HONEST, Two-Door, Live Events,
 * Workshop showcase, footer PDF capture, promo modal, quiz CTAs, and buy-button
 * wiring to the Kajabi offer + pixel/UTM.
 */
import homeCss from '../styles/home.css?raw';
import rawBody from '../home/body.html?raw';
import { site } from '../config/site';
import { offers } from '../config/offers';
import { events, promotedEvent } from '../config/events';
import { conference } from '../config/event-content';

const course = offers.course;
const conf = events['conference'];
const promo = promotedEvent();
const barKey = promo ? `pl_bar_${promo.slug}_${promo.state}` : '';
const announcementBar = promo
  ? `<div class="add-bar" id="announcement-bar" data-key="${barKey}">
      <a class="add-bar-in" href="/${promo.slug}">
        <span class="add-bar-dot"></span>
        <span class="add-bar-msg"><b>The ${promo.edition} Workshop is coming.</b> <span class="add-bar-meta">${promo.dateDisplay} · ${promo.city}</span></span>
        <span class="add-bar-cta">Get first access →</span>
      </a>
      <button class="add-bar-x" id="abar-close" aria-label="Dismiss">×</button>
    </div>`
  : '';
const MONTHS = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
const rows = Object.values(events).filter((e) => e.state !== 'replay').sort((a, b) => a.dateISO.localeCompare(b.dateISO));

// ── Addition sections, styled with the original classes (.container/.eyebrow/.accent) ──
// Trailer — Vimeo embed, click-to-play: the styled facade (poster + play button)
// swaps to the autoplaying player iframe on activation (wired in the client script).
const trailerVimeoId = '1221827154';
// Poster resolves at build time to the video's CURRENT Vimeo thumbnail — change
// the thumbnail on Vimeo and redeploy to change the poster here. Falls back to
// a snapshot URL if the oEmbed call fails during build.
let trailerPoster = 'https://i.vimeocdn.com/video/2194638644-d0f663dd9fe073350a7c038fa3c825e29fe781c3607b8955d79fdd935df5efdc-d_1280x720?region=us';
try {
  const oembed = await fetch(`https://vimeo.com/api/oembed.json?url=https%3A%2F%2Fvimeo.com%2F${trailerVimeoId}`).then((r) => r.json());
  if (oembed?.thumbnail_url) trailerPoster = oembed.thumbnail_url.replace(/_\d+x\d+/, '_1280x720');
} catch { /* keep fallback */ }
const trailer = `
<section class="pl-trailer" id="trailer">
  <div class="container">
    <div class="pl-trailer-head">
      <span class="pl-trailer-eyebrow">Watch the trailer</span>
      <h2>The problem isn't the phone. It's that nobody taught them how to use it.</h2>
      <p>What the course actually looks like — and why families finish it saying the fight finally stopped.</p>
    </div>
    <div class="pl-trailer-stage">
      <div class="pl-trailer-frame" id="trailer-frame" role="button" tabindex="0" aria-label="Play the Phone License trailer" data-vimeo-id="${trailerVimeoId}">
        <img class="pl-trailer-poster" src="${trailerPoster}" alt="" loading="lazy" decoding="async" />
        <span class="pl-trailer-chip">The Trailer</span>
        <span class="pl-trailer-play" aria-hidden="true"><span class="pl-trailer-ring"></span></span>
        <span class="pl-trailer-run">0:58</span>
      </div>
    </div>
    <p class="pl-trailer-cap">Made for parents who are tired of guessing.</p>
    <div class="add-ctas"><a href="#pricing" class="btn btn-dark">Start Phone License — $${course.price}</a><a href="/quiz" class="btn btn-ghost">Not sure? Take the free quiz →</a></div>
  </div>
</section>`;

const beHonest = `
<section class="add-felt">
  <div class="container">
    <p class="eyebrow">Be honest</p>
    ${conference.feltNeed.map((q, i) => `<p class="add-fq" style="opacity:${1 - i * 0.2}">${q}</p>`).join('')}
    <p class="add-fturn">You're not failing. The terrain changed — and nobody briefed you. <span class="accent">That's exactly what Phone License is for.</span></p>
  </div>
</section>`;

const twoDoor = `
<section>
  <div class="container">
    <div class="section-head"><p class="eyebrow">Two doors, one path</p><h2>Two kinds of families end up here. <span class="accent">It works for both.</span></h2></div>
    <div class="add-doors">
      <div class="add-card">
        <p class="add-k">First phone</p><h3>The path to a confident yes.</h3>
        <p>You haven't handed it over yet — and you want the first phone to start on trust, not guesswork. Phone License gives you the agreement, the settings, and the handoff conversation so you can say yes without second-guessing.</p>
      </div>
      <div class="add-card hl">
        <p class="add-k">A fresh start</p><h3>Start over without taking it away.</h3>
        <p>They've had the phone a while and the boundaries slipped. Here's the relief: <b>nothing gets confiscated.</b> The phone gets re-issued under a new agreement they earn — calm, clear, and mutual.</p>
      </div>
    </div>
    <div class="add-ctas"><a href="#pricing" class="btn btn-dark">Start Phone License</a><a href="#course" class="btn btn-ghost">See what's inside →</a></div>
  </div>
</section>`;

// Slim buy band after the Before/After section — the high-intent moment
const midCta = `
<section class="add-band">
  <div class="container-narrow" style="text-align:center">
    <p class="eyebrow">Ready when you are</p>
    <h2>Six weeks from now, <span class="accent">the phone fight is over.</span></h2>
    <div class="add-ctas"><a href="#pricing" class="btn btn-dark">Start Phone License — $${course.price}</a><a href="/quiz" class="btn btn-ghost">Take the free readiness quiz →</a></div>
  </div>
</section>`;

const liveEvents = `
<section class="add-live">
  <div class="container">
    <div class="section-head"><p class="eyebrow" style="color:var(--blue)">Live events · The 2026 Season</p>
      <h2 style="color:#fff">We also run a few <span class="accent">live intensives</span> a year.</h2>
      <p class="add-lsub">Two virtual summits and one in-person workshop, every year — the annual briefing on what actually changed, for parents who don't want to figure it out alone.</p></div>
    <div class="add-rows">
      ${rows.map((e) => {
        const [, m, d] = e.dateISO.split('-').map(Number);
        const kind = e.kind === 'workshop' ? 'In-person workshop · once a year' : `Live virtual summit · ${e.season === 'fall' ? 'Fall' : 'Spring'} ${e.edition}`;
        return `<a class="add-row" href="/${e.slug}"><span class="add-date"><span class="mo">${MONTHS[(m||1)-1]}</span><span class="dy">${d}</span></span><span class="add-mid"><span class="add-kind">${kind}</span><span class="add-title">${e.title}${e.themeLine ? ': ' + e.themeLine : ''}</span></span><span class="add-arrow">→</span></a>`;
      }).join('')}
    </div>
    <div class="add-lfoot"><span class="add-note">One workshop a year · capped at 200 couples</span><a href="/events" class="btn-ghost">See the full season →</a></div>
  </div>
</section>`;

const workshop = `
<section class="add-ws">
  <img class="add-ws-bg" src="/assets/couple-embrace.jpg" alt="" loading="lazy" decoding="async" />
  <div class="add-ws-scrim"></div>
  <div class="container add-ws-in">
    <p class="eyebrow" style="color:var(--blue)">The ${conf.edition} in-person workshop · once a year</p>
    <h2 style="color:#fff">Spend one day with us. <span class="accent">Parent the whole year on purpose.</span></h2>
    <p class="add-ws-lede">${conf.title} is the annual, in-person briefing for parents — both of you in one room in ${conf.city}, then a long-table supper in Leipers Fork. It's the day couples talk about on the drive home.</p>
    <p class="add-ws-meta">${conf.dateDisplay} · ${conf.venue} · Capped at ${conf.capacity} couples</p>
    <div class="add-ws-cta"><a href="/conference" class="btn-white">See the full day →</a></div>
  </div>
</section>`;

const pdfCapture = `
<section class="add-pdf">
  <div class="container add-pdf-grid">
    <div><p class="eyebrow">Free download</p><h3>The Family Phone Contract</h3><p class="add-pdf-sub">The one-page agreement thousands of families sign before the phone changes hands — first phone or a fresh start. We'll email it over.</p></div>
    <form class="add-form" data-lead data-tags="Lead - Contract PDF" data-pixel="Contract PDF" data-next="/quiz" data-next-label="See if they're ready — take the free quiz →" data-title="On its way, {name}." data-body="Check your inbox for the Family Phone Contract.">
      <input type="text" name="name" placeholder="First name" autocomplete="given-name" />
      <input type="email" name="email" placeholder="Email address" required autocomplete="email" />
      <button type="submit" class="btn-dark">Email me the contract</button>
      <p class="add-fine">No spam · one email · unsubscribe anytime.</p>
      <p class="add-err" role="alert" hidden></p>
    </form>
  </div>
</section>`;

const promoModal = `
<div class="add-modal" id="promo-modal">
  <div class="add-scrim" data-close></div>
  <div class="add-dialog" role="dialog" aria-modal="true">
    <button class="add-x" data-close aria-label="Close">×</button>
    <div data-variant="value" hidden>
      <p class="eyebrow">Free · 3 minutes</p><h3>Is your kid ready for a phone?</h3>
      <p>Take the free Smartphone Readiness Assessment. In 3 minutes you'll see exactly where they are — first phone or a fresh start — plus a personalized plan. No email needed to start.</p>
      <a href="/quiz" class="add-btn-blue">See if they're ready →</a><button class="add-dismiss" data-close>Maybe later</button>
    </div>
    <div data-variant="exit" hidden>
      <p class="eyebrow">Before you go</p><h3>Don't leave guessing.</h3>
      <p>The free 3-minute assessment tells you whether they're ready — and the first move to make, whether it's their first phone or a reset.</p>
      <a href="/quiz" class="add-btn-blue">Take the free quiz →</a><button class="add-dismiss" data-close>No thanks, keep reading</button>
    </div>
  </div>
</div>`;

// Mobile menu: the original nav hides its links ≤760px and offers nothing in
// their place. Inject a hamburger (last item in the pill) + a dropdown panel
// (sibling of <nav>, so it can span the .nav-wrap width).
const navMenu = `
    <button class="add-burger" id="nav-burger" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
      <span></span><span></span><span></span>
    </button>
  </nav>
  <div class="add-nav-menu" id="nav-menu" hidden>
    <a href="#course">Course</a>
    <a href="/quiz">Free quiz</a>
    <a href="/conference">The Workshop</a>
    <a href="/events">Events</a>
    <a href="/churches">For churches</a>
  </div>`;

// ── Inject additions into the verbatim original body at the original anchors ──
// Strip the inner <body> wrapper so placement is clean, then add the bar on top.
let body = rawBody.replace(/^\s*<body[^>]*>/, '').replace(/<\/body>\s*$/, '');
body = announcementBar + body;
// hamburger into the nav pill (first </nav> is the primary nav)
body = body.replace('</nav>', navMenu);
// buy buttons → Kajabi course offer (UTM + InitiateCheckout wired client-side)
// The match string keeps the original "$49" because that is what the verbatim
// body.html literally says — do not edit that file. The PRICE SHOWN comes from
// offers.course, so raising it is a one-line config change, not an HTML edit.
body = body.replaceAll('<a href="#pricing" class="cta">Start — $49</a>', `<a href="${course.url}" class="cta" data-kajabi data-offer-value="${course.pixelValue}" data-offer-name="Phone License course"${course.url.startsWith('#') ? ' data-todo="true"' : ''}>Start — $${course.price}</a>`);
// after hero
body = body.replace('<!-- ============================ FELT NEED', trailer + beHonest + twoDoor + '\n<!-- ============================ FELT NEED');
// buy band after before/after
body = body.replace('<!-- ============================ MEET YOUR GUIDES', midCta + '\n<!-- ============================ MEET YOUR GUIDES');
// live events before curriculum
body = body.replace('<!-- ============================ CURRICULUM', liveEvents + '\n<!-- ============================ CURRICULUM');
// workshop before pricing
body = body.replace('<!-- ============================ PRICING', workshop + '\n<!-- ============================ PRICING');
// footer PDF capture before footer — gated on the site-wide contractLead flag
if (site.contractLead) {
  body = body.replace('<!-- ============================ FOOTER', pdfCapture + '\n<!-- ============================ FOOTER');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Phone License — Earn the phone. Keep the trust.</title>
    <meta name="description" content="A parent + teen course that turns phone access into earned trust — first phone or a fresh start on the one they already have." />
    <meta property="og:title" content="Phone License — Earn the phone. Keep the trust." />
    <meta property="og:description" content="A parent + teen course that turns phone access into earned trust — first phone or a fresh start on the one they already have." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Phone License" />
    <meta property="og:url" content="https://phonelicense.co/" />
    <meta property="og:image" content="https://phonelicense.co/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://phonelicense.co/og.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:inline set:html={homeCss}></style>

    {/* Announcement bar: hide pre-paint if this event+state was dismissed */}
    {barKey && (
      <script is:inline define:vars={{ barKey }}>
        try{if(localStorage.getItem(barKey)==='1')document.documentElement.classList.add('abar-hide');}catch(e){}
      </script>
    )}

    {/* Integration config for the client libs */}
    <script is:inline define:vars={{ webhookUrl: site.webhookUrl, pixelId: site.metaPixelId }}>
      window.__PL = { webhookUrl: webhookUrl, pixelId: pixelId };
      window._plPixelId = pixelId;
    </script>
    {site.metaPixelId && (
      <script is:inline define:vars={{ pixelId: site.metaPixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init', pixelId);fbq('track','PageView');
      </script>
    )}
  </head>
  <body>
    <Fragment set:html={body} />
    <Fragment set:html={promoModal} />

    {/* ── Styles for the injected additions (original tokens/classes) ── */}
    <style is:inline>
      .abar-hide .add-bar{display:none}
      .add-bar{position:relative;background:var(--blue-tint,#eef2fa);border-bottom:1px solid var(--blue-tint-2,#dde7f7);font-size:14px}
      .add-bar-in{display:flex;align-items:center;gap:10px;max-width:1180px;margin:0 auto;padding:10px 44px 10px 28px;text-decoration:none;color:var(--ink);min-height:40px}
      .add-bar-dot{width:7px;height:7px;border-radius:50%;background:var(--blue,#4f83cc);flex:none}
      .add-bar-msg{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .add-bar-meta{color:var(--muted);margin-left:8px}
      .add-bar-cta{margin-left:auto;font-weight:600;white-space:nowrap;color:var(--blue-deep,#3a68b5)}
      .add-bar-x{position:absolute;top:50%;right:12px;transform:translateY(-50%);width:32px;height:32px;background:none;border:none;font-size:20px;color:inherit;opacity:.55;cursor:pointer}
      @media(max-width:620px){.add-bar-meta{display:none}}
      .add-burger{display:none}
      @media(max-width:760px){
        .nav .brand,.nav .cta{white-space:nowrap}
        .add-burger{display:flex;flex-direction:column;justify-content:center;gap:5px;width:40px;height:40px;padding:10px;margin-left:2px;background:none;border:none;border-radius:50%;cursor:pointer}
        .add-burger span{display:block;height:2px;width:100%;background:var(--ink);border-radius:2px;transition:transform .2s ease,opacity .15s ease}
        .add-burger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
        .add-burger[aria-expanded="true"] span:nth-child(2){opacity:0}
        .add-burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
      }
      .add-nav-menu{position:absolute;top:calc(100% + 10px);left:16px;right:16px;z-index:60;pointer-events:auto;display:flex;flex-direction:column;padding:10px;background:rgba(255,255,255,.92);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow-md)}
      .add-nav-menu a{padding:14px 18px;border-radius:14px;font-size:17px;font-weight:500;color:var(--ink);text-decoration:none}
      .add-nav-menu a:active,.add-nav-menu a:hover{background:rgba(15,15,16,.06)}
      .add-nav-menu[hidden]{display:none}
      .add-ctas{display:flex;gap:12px;justify-content:center;margin-top:36px;flex-wrap:wrap}
      .add-band{background:var(--bg-2)}
      .add-band .eyebrow{display:inline-block;margin-bottom:14px}
      .pl-trailer-head{text-align:center;max-width:720px;margin:0 auto 44px}
      .pl-trailer-eyebrow{display:inline-block;margin-bottom:14px;font-family:var(--mono);font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:var(--blue-deep);font-weight:500}
      .pl-trailer-head h2{font-family:var(--display);font-weight:700;letter-spacing:-0.035em;line-height:1.02;margin:0;color:var(--ink);text-wrap:balance;font-size:clamp(32px,4.4vw,54px)}
      .pl-trailer-head p{margin:16px 0 0;font-size:19px;color:var(--muted);line-height:1.5;text-wrap:pretty}
      .pl-trailer-stage{position:relative;max-width:1000px;margin:0 auto}
      .pl-trailer-stage::before{content:"";position:absolute;inset:6% 4% -6% 4%;border-radius:50%;background:radial-gradient(ellipse at center, rgba(15,15,16,0.22), transparent 70%);filter:blur(46px);z-index:0}
      .pl-trailer-frame{position:relative;z-index:1;aspect-ratio:16/9;border-radius:var(--r-lg);overflow:hidden;cursor:pointer;background:repeating-linear-gradient(135deg, rgba(255,255,255,0.035) 0 14px, transparent 14px 28px),linear-gradient(155deg, #26262a 0%, #131316 55%, #0a0a0b 100%);box-shadow:var(--shadow-lg), inset 0 0 0 1px rgba(255,255,255,0.07);display:flex;align-items:center;justify-content:center}
      .pl-trailer-frame::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 42%, rgba(255,255,255,0.07), transparent 62%)}
      .pl-trailer-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
      .pl-trailer-poster ~ .pl-trailer-play,.pl-trailer-poster ~ .pl-trailer-chip,.pl-trailer-poster ~ .pl-trailer-run{z-index:2}
      .pl-trailer-frame.is-playing{cursor:default}
      .pl-trailer-frame.is-playing::after{display:none}
      .pl-trailer-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0;z-index:3}
      .pl-trailer-play{position:relative;width:96px;height:96px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 18px 46px rgba(0,0,0,0.42);transition:transform .18s ease}
      .pl-trailer-play::after{content:"";width:0;height:0;margin-left:7px;border-left:26px solid var(--ink);border-top:16px solid transparent;border-bottom:16px solid transparent}
      .pl-trailer-frame:hover .pl-trailer-play{transform:scale(1.07)}
      .pl-trailer-ring{position:absolute;inset:-14px;border-radius:50%;border:1px solid rgba(255,255,255,0.35);animation:plTrailerPulse 2.8s ease-out infinite}
      @keyframes plTrailerPulse{0%{transform:scale(1);opacity:0.6}70%{transform:scale(1.28);opacity:0}100%{opacity:0}}
      @media (prefers-reduced-motion:reduce){.pl-trailer-ring{animation:none;opacity:0.35}}
      .pl-trailer-chip{position:absolute;top:20px;left:22px;z-index:2;font-family:var(--mono);font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.78);background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);padding:8px 13px;border-radius:999px}
      .pl-trailer-run{position:absolute;bottom:20px;right:22px;z-index:2;font-family:var(--mono);font-size:11px;letter-spacing:0.12em;color:rgba(255,255,255,0.55)}
      .pl-trailer-cap{text-align:center;margin:22px 0 0;font-size:15px;color:var(--muted)}
      @media (max-width:600px){.pl-trailer-play{width:72px;height:72px}.pl-trailer-play::after{border-left-width:20px;border-top-width:12px;border-bottom-width:12px}}
      .add-felt{background:var(--bg-2);text-align:center}
      .add-felt .eyebrow{display:block;margin-bottom:20px}
      .add-fq{font-family:var(--font-display,Inter);font-weight:700;font-size:clamp(28px,5vw,52px);letter-spacing:-.035em;color:var(--ink);line-height:1.08;margin-top:6px;max-width:900px;margin-inline:auto}
      .add-fturn{max-width:660px;margin:34px auto 0;font-size:clamp(17px,2.2vw,21px);color:var(--ink-2)}
      .add-doors{display:grid;gap:20px;margin-top:40px}
      @media(min-width:720px){.add-doors{grid-template-columns:1fr 1fr}}
      .add-card{background:var(--surface,#fff);border:1px solid var(--line,rgba(15,15,16,.08));border-radius:22px;padding:28px;box-shadow:0 1px 2px rgba(15,15,16,.04),0 4px 14px rgba(15,15,16,.05)}
      .add-card.hl{background:var(--blue-tint,#eef2fa);border-color:var(--blue-tint-2,#dde7f7)}
      .add-card h3{margin:8px 0}
      .add-card p:last-child{color:var(--ink-2);margin-top:8px}
      .add-k{font-family:var(--font-mono,monospace);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--blue-deep,#3a68b5)}
      .add-live{background:var(--ink);color:#fff}
      .add-live .add-lsub{color:rgba(255,255,255,.72);max-width:580px;margin:12px auto 0}
      .add-rows{margin-top:28px}
      .add-row{display:grid;grid-template-columns:64px 1fr auto;align-items:center;gap:16px;padding:22px 4px;border-top:1px solid rgba(255,255,255,.12);color:#fff;text-decoration:none}
      .add-row:hover{background:rgba(255,255,255,.04)}
      .add-date{display:flex;flex-direction:column;align-items:center;line-height:1}
      .add-date .mo{font-family:var(--font-mono,monospace);font-size:11px;letter-spacing:.1em;color:var(--blue,#4f83cc)}
      .add-date .dy{font-family:var(--font-display,Inter);font-weight:700;font-size:30px;letter-spacing:-.03em}
      .add-mid{display:flex;flex-direction:column;gap:3px;min-width:0}
      .add-kind{font-family:var(--font-mono,monospace);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.55)}
      .add-title{font-family:var(--font-display,Inter);font-weight:600;font-size:17px;letter-spacing:-.02em}
      .add-arrow{color:rgba(255,255,255,.6);font-size:18px}
      .add-lfoot{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;padding-top:26px}
      .add-note{font-family:var(--font-mono,monospace);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.5)}
      .add-ws{position:relative;overflow:hidden;color:#fff;background:var(--ink)}
      .add-ws-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.9}
      .add-ws-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,15,16,.72),rgba(15,15,16,.86))}
      .add-ws-in{position:relative;text-align:center}
      .add-ws-lede{max-width:640px;margin:16px auto 0;color:rgba(255,255,255,.82);font-size:clamp(16px,2.2vw,19px)}
      .add-ws-meta{font-family:var(--font-mono,monospace);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-top:18px}
      .add-ws-cta{margin-top:30px}
      .btn-white{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--ink);font-weight:500;font-size:15.5px;padding:15px 26px;border-radius:999px;text-decoration:none}
      .add-pdf{background:var(--bg-2)}
      .add-pdf-grid{display:grid;gap:28px;align-items:center}
      @media(min-width:820px){.add-pdf-grid{grid-template-columns:1fr 420px}}
      .add-pdf h3{margin:10px 0}
      .add-pdf-sub{color:var(--muted);max-width:42ch}
      .add-form{display:flex;flex-direction:column;gap:10px;max-width:440px}
      .add-form input{width:100%;padding:14px 16px;font-size:16px;border:1px solid var(--line-2,rgba(15,15,16,.14));border-radius:999px;font-family:inherit;background:#fff}
      .add-form button{width:100%;cursor:pointer;border:none;font-size:15.5px;padding:15px 24px;border-radius:999px}
      .add-ws-cta .btn-white,.add-dialog .btn-dark{display:inline-flex;align-items:center;justify-content:center}
      .add-fine{font-size:12px;color:var(--muted)}
      .add-err{color:#b23b3b;font-size:13px}
      .add-modal{position:fixed;inset:0;z-index:200;display:none;align-items:center;justify-content:center;padding:20px}
      .add-modal.open{display:flex}
      .add-scrim{position:absolute;inset:0;background:rgba(15,15,16,.45);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}
      .add-dialog{position:relative;max-width:430px;width:100%;padding:34px 30px;text-align:center;background:#fff;border-radius:24px;box-shadow:0 30px 80px rgba(15,15,16,.28),0 8px 24px rgba(15,15,16,.12)}
      .add-dialog h3{margin:8px 0 12px;font-size:clamp(24px,4vw,30px);letter-spacing:-.03em}
      .add-dialog p{color:var(--ink-2);margin-bottom:24px;line-height:1.5}
      .add-x{position:absolute;top:12px;right:14px;width:32px;height:32px;background:none;border:none;font-size:24px;color:var(--muted);cursor:pointer}
      .add-btn-blue{display:inline-flex;align-items:center;justify-content:center;width:100%;background:var(--blue,#4f83cc);color:#fff;font-weight:600;font-size:16px;padding:16px 24px;border-radius:999px;text-decoration:none;box-shadow:0 8px 22px rgba(79,131,204,.35);transition:transform .18s ease,background .18s ease}
      .add-btn-blue:hover{background:var(--blue-deep,#3a68b5);transform:translateY(-1px)}
      .add-dismiss{display:block;margin:16px auto 0;background:none;border:none;color:var(--muted);font-size:13.5px;cursor:pointer;font-family:inherit}
      .add-confirmed{text-align:left}
      .add-confirmed h3{margin-bottom:8px}
      .add-confirmed .btn-dark{margin-top:14px}
    </style>

    {/* ── Behavior: UTM/pixel/webhook, buy clicks, forms, promo modal ── */}
    <script>
      import { captureUtms, appendUtms } from '../lib/utm';
      import { initiateCheckout, viewContent } from '../lib/pixel';
      import { submitLead } from '../lib/lead';

      captureUtms();
      viewContent('Sales Page');

      // Announcement bar dismiss
      const abar = document.getElementById('announcement-bar');
      document.getElementById('abar-close')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const k = abar?.dataset.key || '';
        if (k) { try { localStorage.setItem(k, '1'); } catch {} }
        document.documentElement.classList.add('abar-hide');
      });

      // Mobile hamburger menu
      const burger = document.getElementById('nav-burger');
      const navMenu = document.getElementById('nav-menu');
      if (burger && navMenu) {
        const setMenu = (open: boolean) => {
          burger.setAttribute('aria-expanded', String(open));
          navMenu.hidden = !open;
        };
        burger.addEventListener('click', () => setMenu(navMenu.hidden));
        navMenu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
        document.addEventListener('click', (e) => {
          if (!navMenu.hidden && !(e.target as HTMLElement).closest('.nav-wrap')) setMenu(false);
        });
      }

      // Trailer: swap the facade for the autoplaying Vimeo player on activation
      const trailerFrame = document.getElementById('trailer-frame');
      if (trailerFrame) {
        const playTrailer = () => {
          if (trailerFrame.classList.contains('is-playing')) return;
          trailerFrame.classList.add('is-playing');
          const iframe = document.createElement('iframe');
          iframe.src = `https://player.vimeo.com/video/${trailerFrame.dataset.vimeoId}?autoplay=1&title=0&byline=0&portrait=0&dnt=1`;
          iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
          iframe.allowFullscreen = true;
          iframe.title = 'Phone License trailer';
          trailerFrame.replaceChildren(iframe);
          trailerFrame.removeAttribute('role');
          trailerFrame.removeAttribute('tabindex');
          trailerFrame.removeAttribute('aria-label');
        };
        trailerFrame.addEventListener('click', playTrailer);
        trailerFrame.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); playTrailer(); }
        });
      }

      // Kajabi buy links: append UTMs + InitiateCheckout
      document.querySelectorAll<HTMLAnchorElement>('a[data-kajabi]').forEach((a) => {
        if (a.dataset.todo !== 'true') a.href = appendUtms(a.href);
      });
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement)?.closest?.('a[data-kajabi]');
        if (!a) return;
        initiateCheckout(Number((a as HTMLElement).dataset.offerValue || 0), (a as HTMLElement).dataset.offerName || 'offer');
      });

      // Lead forms (footer PDF, etc.)
      document.querySelectorAll<HTMLFormElement>('form[data-lead]').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const data = new FormData(form);
          const email = String(data.get('email') || '').trim();
          const name = String(data.get('name') || '').trim();
          const err = form.querySelector<HTMLElement>('.add-err');
          if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { if (err) { err.textContent = 'Please enter a valid email.'; err.hidden = false; } return; }
          if (err) err.hidden = true;
          const btn = form.querySelector('button'); if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
          await submitLead({ name, email, tags: (form.dataset.tags || '').split('|').filter(Boolean), pixelName: form.dataset.pixel });
          const title = (form.dataset.title || 'Got it, {name}.').replace('{name}', name || 'friend');
          form.innerHTML = `<div class="add-confirmed"><h3>${title}</h3><p>${form.dataset.body || ''}</p><a class="btn-dark" href="${form.dataset.next || '/quiz'}">${form.dataset.nextLabel || 'Take the free quiz →'}</a></div>`;
        });
      });

      // Promo modal: 5s value offer + exit intent
      const modal = document.getElementById('promo-modal');
      if (modal) {
        const V = 'pl_promo_value', X = 'pl_promo_exit';
        const vv = modal.querySelector<HTMLElement>('[data-variant="value"]')!;
        const xv = modal.querySelector<HTMLElement>('[data-variant="exit"]')!;
        let open = false;
        const seen = (k: string) => { try { return sessionStorage.getItem(k) === '1'; } catch { return false; } };
        const show = (which: 'value' | 'exit', key: string) => {
          if (open || seen(key)) return; open = true; try { sessionStorage.setItem(key, '1'); } catch {}
          vv.hidden = which !== 'value'; xv.hidden = which !== 'exit'; modal.classList.add('open'); document.body.style.overflow = 'hidden';
        };
        const close = () => { open = false; modal.classList.remove('open'); document.body.style.overflow = ''; };
        setTimeout(() => show('value', V), 5000);
        let inPage = false;
        document.addEventListener('mousemove', () => (inPage = true), { once: true });
        document.addEventListener('mouseout', (e) => { if (inPage && !e.relatedTarget && (e as MouseEvent).clientY <= 0) show('exit', X); });
        modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) close(); });
      }
    </script>
  </body>
</html>
