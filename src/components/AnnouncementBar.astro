---
/**
 * Site-wide announcement bar. Both entries from /config/announcement are
 * rendered; the pre-paint script in Base (see barPrepaintScript) sets
 * html[data-bar] to the active one, and the CSS below shows only that bar.
 * Dismissal is remembered per bar key. Elegant, not car-dealer.
 */
import { announcement } from '../config/announcement';

const bars = [
  { id: 'launch', ...announcement.launch },
  { id: 'season', ...announcement.season },
];
---

{
  bars.map((b) => (
    <div class="abar tint" data-bar-id={b.id} data-dismiss-key={b.key}>
      <a class="abar-in wrap" href={b.href}>
        <span class="dot" aria-hidden="true" />
        <span class="msg">
          <b>{b.strong}</b>
          <span class="meta">{b.text}</span>
        </span>
        <span class="cta">{b.cta} →</span>
      </a>
      <button class="abar-x" aria-label="Dismiss" data-abar-close>
        ×
      </button>
    </div>
  ))
}

<style>
  /* Hidden until <head> picks the active bar — no flash, no layout shift. */
  .abar {
    display: none;
    position: relative;
    font-size: 14px;
  }
  :global(html[data-bar='launch']) .abar[data-bar-id='launch'],
  :global(html[data-bar='season']) .abar[data-bar-id='season'] {
    display: block;
  }
  .abar.tint {
    background: var(--blue-tint);
    color: var(--ink);
    border-bottom: 1px solid var(--blue-tint-2);
  }
  .abar-in {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 44px 10px 20px;
    text-decoration: none;
    color: inherit;
    min-height: 40px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
    flex: none;
    animation: pulse 1.8s ease-in-out infinite;
  }
  .msg {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .msg .meta {
    color: var(--muted);
    margin-left: 8px;
  }
  .cta {
    margin-left: auto;
    font-weight: 600;
    white-space: nowrap;
    color: var(--blue-deep);
  }
  .abar-x {
    position: absolute;
    top: 50%;
    right: 8px;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    font-size: 20px;
    line-height: 1;
    color: inherit;
    opacity: 0.55;
    cursor: pointer;
  }
  .abar-x:hover {
    opacity: 1;
  }
  @media (max-width: 620px) {
    .msg .meta {
      display: none;
    }
    .cta {
      font-size: 13px;
    }
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-abar-close]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const key = btn.closest<HTMLElement>('.abar')?.dataset.dismissKey || '';
      try {
        if (key) localStorage.setItem(key, '1');
      } catch {}
      document.documentElement.removeAttribute('data-bar');
    });
  });
</script>
