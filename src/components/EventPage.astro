---
/**
 * One template, three event pages (/summit-spring, /summit-summer,
 * /conference). Everything comes from /config/events — a page file is just
 * `<EventPage slug="…" />`.
 *
 * Top to bottom: eyebrow · heading · promise · status strip · body · "You’ll
 * leave with" · "Who it’s for" · the waitlist form (this event pre-ticked) ·
 * three-question FAQ · "Also this season" · start the course while you wait.
 */
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Faq from './Faq.astro';
import WaitlistForm from './WaitlistForm.astro';
import { events, otherEvents, eyebrowFor, statusStrip, eventFaqs, eventTitle } from '../config/events';
import { offers } from '../config/offers';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const e = events[slug];
if (!e) throw new Error(`EventPage: unknown event slug "${slug}"`);
const course = offers.course;
const others = otherEvents(slug);
const strip = statusStrip(e);
const showTheme = e.theme !== e.shortName;
---

<Base title={eventTitle(e)} description={e.description} viewContent={e.shortName} ogImage={e.ogImage}>
  <Nav yearMark="2027" cta={{ label: 'Get first access', href: '#waitlist' }} />

  <main>
    {/* ── Hero ── */}
    <section class="section hero">
      <div class="wrap narrow">
        <p class="eyebrow">{eyebrowFor(e)}</p>
        <h1>
          {showTheme ? (
            <>
              {e.shortName}: <span class="accent">{e.theme}</span>
            </>
          ) : (
            <>
              {e.shortName}<span class="accent">.</span>
            </>
          )}
        </h1>
        <p class="lede">{e.promise}</p>
        <div class="ctas">
          <a href="#waitlist" class="btn btn-primary">Get first access</a>
          <a href="/#pricing" class="btn btn-ghost">Start the course while you wait →</a>
        </div>

        <dl class="strip card">
          {strip.map((s) => (
            <div>
              <dt class="mono">{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    {/* ── Body ── */}
    <section class="section band-2">
      <div class="wrap narrow">
        {e.body.map((p) => <p class="body">{p}</p>)}

        <div class="two">
          <div class="card block">
            <p class="mono">You’ll leave with</p>
            <ul class="leave">
              {e.leaveWith.map((x) => <li>{x}</li>)}
            </ul>
          </div>
          <div class="card block">
            <p class="mono">Who it’s for</p>
            <p class="who">{e.whoFor}</p>
            <p class="who rec">
              <b>Recorded:</b> {e.recorded ? 'yes, for everyone registered.' : 'no. That’s the point of the room.'}
            </p>
            {e.travel && (
              <p class="who">
                <b>Travel:</b> {e.travel}
              </p>
            )}
          </div>
        </div>
      </div>
    </section>

    {/* ── Waitlist ── */}
    <section class="section" id="first-access">
      <div class="wrap">
        <WaitlistForm preselect={e.slug} />
      </div>
    </section>

    {/* ── FAQ ── */}
    <section class="section band-2">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Questions</p>
          <h2>The three everyone asks.</h2>
        </div>
        <Faq items={eventFaqs(e)} name="event-faq" />
      </div>
    </section>

    {/* ── Also this season ── */}
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Also this season</p>
          <h2>Two more days a year.</h2>
        </div>
        <div class="others">
          {others.map((o) => (
            <a class="card other" href={`/${o.slug}`}>
              <p class="mono">{eyebrowFor(o)}</p>
              <h3>{o.name}</h3>
              <p class="o-line">{o.oneLine}</p>
              <span class="go">Get first access →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ── Closing ── */}
    <section class="section closing band-ink">
      <div class="wrap narrow center">
        <p class="eyebrow">While you wait</p>
        <h2>Start the course while you wait for a room.</h2>
        <p class="c-sub">Six weeks, one agreement, a rite of passage your kid will remember. Everything at the events builds on it.</p>
        <div class="ctas center">
          <a
            href={course.url}
            class="btn btn-white"
            data-kajabi
            data-offer-value={course.pixelValue}
            data-offer-name="Phone License course"
          >
            Start Phone License — ${course.price}
          </a>
          <a href="#waitlist" class="btn btn-ghost">Get first access</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .narrow {
    max-width: 820px;
  }
  .center {
    text-align: center;
  }
  .hero {
    padding-block: 56px 40px;
  }
  .hero h1 {
    margin-top: 14px;
    font-size: clamp(36px, 7vw, 66px);
  }
  .hero .lede {
    margin-top: 18px;
    max-width: 640px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .ctas.center {
    justify-content: center;
  }
  .strip {
    display: grid;
    gap: 16px;
    margin-top: 36px;
    padding: 20px 22px;
  }
  .strip dd {
    margin-top: 4px;
    font-weight: 500;
    color: var(--ink);
  }
  .body {
    font-size: clamp(17px, 2.2vw, 20px);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .body + .body {
    margin-top: 16px;
  }
  .two {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }
  .block {
    padding: 22px;
  }
  .leave {
    list-style: none;
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .leave li {
    position: relative;
    padding-left: 22px;
    color: var(--ink);
  }
  .leave li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--blue-deep);
  }
  .who {
    margin-top: 10px;
    color: var(--ink-2);
  }
  .who b {
    color: var(--ink);
    font-weight: 600;
  }
  .section-head {
    text-align: center;
    max-width: var(--head-maxw);
    margin: 0 auto 32px;
  }
  .section-head .eyebrow {
    margin-bottom: 12px;
  }
  .others {
    display: grid;
    gap: 16px;
  }
  .other {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .other:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .o-line {
    color: var(--ink-2);
  }
  .go {
    margin-top: auto;
    padding-top: 8px;
    font-weight: 600;
    color: var(--blue-deep);
  }
  .closing .c-sub {
    color: rgba(255, 255, 255, 0.75);
    max-width: 52ch;
    margin: 14px auto 0;
  }
  .closing h2 {
    margin-top: 12px;
  }
  @media (min-width: 720px) {
    .strip {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .two,
    .others {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
