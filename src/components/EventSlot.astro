---
/**
 * The config-driven event card on every thank-you state (quiz results, church
 * confirmation). In the 2027 model there is no "next dated event", so it
 * carries the season: three events, first access, one doorway → /events.
 */
import { season } from '../config/events';
---

<a class="evslot card" href="/events">
  <div class="top">
    <span class="mono">Live events · The 2027 season</span>
    <span class="pill">Waitlist open</span>
  </div>
  <h4>A few days a year, we get in a room.</h4>
  <p class="meta">
    {season.map((e, i) => (
      <span>{e.season.split(' ')[0]} · {e.shortName}{i < season.length - 1 ? ' · ' : ''}</span>
    ))}
  </p>
  <span class="go">Get first access →</span>
</a>

<style>
  .evslot {
    display: block;
    padding: 20px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .evslot:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue-deep);
    background: var(--blue-tint);
    padding: 4px 9px;
    border-radius: var(--r-pill);
    white-space: nowrap;
  }
  h4 {
    margin-bottom: 6px;
  }
  .meta {
    font-size: 14px;
    color: var(--muted);
  }
  .go {
    display: inline-block;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--blue-deep);
  }
</style>
